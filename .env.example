# Copiar a .env (local) o cargar como variables en Railway → Variables. Nunca versionar .env.

# Obligatorias en producción
ADMIN_PASSWORD=cambiar-por-una-clave-larga      # crea el usuario "admin" la primera vez (después se cambia desde Equipo)
SITE_URL=https://pollito.up.railway.app         # la URL pública exacta (con https). Habilita cookies seguras, PWA instalable, push y GPS
APP_MODE=equipo                                 # equipo = solo administración y reparto; completo = también el portal de clientes

# Datos (Railway: montar un volumen en /data; el Dockerfile ya define DATA_DIR=/data)
# DATA_DIR=/data
# DB_PATH=/data/pollito.sqlite

# Opcionales
# ADMIN_WHATSAPP=5492635037286                  # WhatsApp de administración que ven los repartidores
# LOGIN_LIMIT=6                                 # intentos de ingreso por minuto e IP
# PUSH=off                                      # apaga los avisos push (por defecto encendidos; las claves VAPID se generan solas en /data)
# GEOCODING=off  ROUTING=off                    # apaga Nominatim / cálculo de ETA
# SMTP_URL=smtps://usuario:clave@smtp.gmail.com:465  MAIL_FROM="Pollito Casero <pedidos@…>"
# GOOGLE_CLIENT_ID=…                            # ingreso con Google (portal de clientes)
# WHATSAPP_TOKEN=…  WHATSAPP_PHONE_ID=…         # código OTP real por WhatsApp (portal de clientes)
# MP_ACCESS_TOKEN=…                             # Mercado Pago Checkout Pro
# TRANSFER_ALIAS=…  TRANSFER_CVU=…  TRANSFER_HOLDER=…
# DEMO=1                                        # solo para probar: muestra códigos y enlaces de prueba

# Archivo documental de Google Drive. OAuth de la cuenta con acceso a la carpeta; nunca VITE_*.
# DRIVE_FOLDER_ID=1ocqnaKCa0U4C4ukOgtH4OvEt9-azQ1lX
# DRIVE_CLIENT_ID=
# DRIVE_CLIENT_SECRET=
# DRIVE_REFRESH_TOKEN=
